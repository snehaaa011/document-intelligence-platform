# Copy this file to backend/.env (or export these in your shell / hosting
# platform's environment settings) and fill in real values. NEVER commit
# a real .env file.

# --- General ---------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Local dev default (file-based, NOT persistent on most cloud hosts):
DATABASE_URL=sqlite:///./document_intelligence.db
# Production (Render/Railway/Koyeb-provided Postgres connection string):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- CORS ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5500,http://localhost:3000,http://localhost:8080

# --- Upload / page limits --------------------------------------------------------
MAX_PAGE_COUNT=3
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads

# --- OCR ---------------------------------------------------------------------------
OCR_PROVIDER=tesseract
OCR_DPI=300
TESSERACT_CMD=tesseract

# --- LLM extraction -----------------------------------------------------------------
# LLM_PROVIDER: "gemini" | "rule_based"
#
# "gemini" uses Google's Gemini models through Google's OpenAI-compatible
# endpoint (https://ai.google.dev/gemini-api/docs/openai). The official
# `openai` Python package is used only as a generic REST client pointed at
# Google's base URL below -- this project does NOT call OpenAI's own API
# service and does NOT require an OpenAI API key.
#
# Leave LLM_API_KEY empty to automatically and safely use the deterministic
# rule_based fallback extractor (reduced field coverage, but requires no
# API key and works fully offline).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Google's documented OpenAI-compatible Gemini endpoint. Only change this
# if Google updates the documented URL -- never point it at
# https://api.openai.com/.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Validation tolerances --------------------------------------------------------
VALIDATION_ABS_TOLERANCE=0.01
VALIDATION_REL_TOLERANCE=0.001

# --- API ---------------------------------------------------------------------------
# Used by the frontend (frontend/index.html sets window.API_BASE_URL, or
# override it at deploy time via your static host's environment/build step).
API_BASE_URL=http://localhost:8000
